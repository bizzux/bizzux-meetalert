{
  "expo": {
    "name": "Meeting Reminder",
    "slug": "meeting-reminder-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bizzux.meetingreminder",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSCalendarsUsageDescription": "Meeting Reminder reads your device calendar so it can remind you about meetings on it."
      }
    },
    "android": {
      "package": "com.bizzux.meetingreminder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "permissions": [
        "READ_CALENDAR",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://pkgs.dev.azure.com/MicrosoftDeviceSDK/DuoSDK-Public/_packaging/Duo-SDK-Feed/maven/v1"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "70d792dd-d31d-4d49-9801-a7582dcf1087"
      }
    },
    "owner": "bizzux"
  }
}
